#!/bin/ash
# VLESS Reality benchmark and HomeProxy helper for OpenWrt/BusyBox.
set -u

SUB_FILE=${VPN_SUBSCRIPTION_FILE:-}
SUB_URL=${VPN_SUBSCRIPTION_URL:-}
TEST_URL='https://detectportal.firefox.com/success.txt'
MAX_NODES=0
BASE_PORT=18080
MODE=benchmark
NODE_INDEX=''
SECTION=vless_auto
ROUTING_NODE=''
SUB_OUTPUT=subscription.sub
APPLY_BEST=0
ENV_FILE=${VPN_ENV_FILE:-}
AUTO_TEST_URL='https://www.youtube.com/'
YOUTUBE_RESULT='ещё не проверено'
AUTO_BACKUP=''
AUTO_SUCCESS=0
AUTO_LOCK=0
AUTO_LOCK_DIR=${VPN_AUTO_LOCK_DIR:-/tmp/vpn-auto.lock}
SUB_TEMP=''
HOMEPROXY_CONFIG=${VPN_HOMEPROXY_CONFIG:-/etc/config/homeproxy}
HOMEPROXY_SERVICE=${VPN_HOMEPROXY_SERVICE:-/etc/init.d/homeproxy}
HOMEPROXY_RUNTIME_CONFIG=${VPN_HOMEPROXY_RUNTIME_CONFIG:-/var/run/homeproxy/sing-box-c.json}
WORK_DIR="/tmp/openwrt-vless.$$"
RAW="$WORK_DIR.raw"
TEXT="$WORK_DIR.txt"
NODES="$WORK_DIR.nodes"
RESULTS="$WORK_DIR.results"
CANDIDATES="$WORK_DIR.candidates"
TAB=$(printf '\t')
SB_PID=''

if [ -z "$SUB_FILE" ]; then
    if [ -s /root/subscription.sub ]; then
        SUB_FILE=/root/subscription.sub
    elif [ -s /root/connliberty.sub ]; then
        SUB_FILE=/root/connliberty.sub
    else
        SUB_FILE=/root/subscription.sub
    fi
fi

log() { printf '%s\n' "$*"; }
err() { printf 'ERROR: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "не найдена команда $1"; }
cleanup() {
    [ -n "$SB_PID" ] && kill "$SB_PID" >/dev/null 2>&1 || true
    rm -f "$RAW" "$TEXT" "$NODES" "$NODES.raw" "$NODES.ok" "$RESULTS" "$CANDIDATES" "$WORK_DIR".*.json "$WORK_DIR".*.log
    [ -z "$SUB_TEMP" ] || rm -f "$SUB_TEMP"
    if [ -n "$AUTO_BACKUP" ] && [ "$AUTO_SUCCESS" != 1 ]; then
        if cp -p "$AUTO_BACKUP" "$HOMEPROXY_CONFIG"; then
            "$HOMEPROXY_SERVICE" restart >/dev/null 2>&1 || err 'не удалось перезапустить HomeProxy после восстановления'
            err "auto не завершился успешно; конфигурация восстановлена из $AUTO_BACKUP"
        else
            err "не удалось восстановить HomeProxy из $AUTO_BACKUP"
        fi
    fi
    [ "$AUTO_LOCK" != 1 ] || rmdir "$AUTO_LOCK_DIR" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

youtube_available() {
    proxy_port=$(jq -r '.inbounds[]? | select(.type == "mixed") | .listen_port' \
        "$HOMEPROXY_RUNTIME_CONFIG" 2>/dev/null | head -n 1)
    case "$proxy_port" in
        ''|*[!0-9]*) YOUTUBE_RESULT='mixed-in HomeProxy не найден'; return 2;;
    esac
    if code=$(curl -sS -L --proxy "http://127.0.0.1:$proxy_port" --noproxy '' \
        --max-redirs 3 --connect-timeout 5 --max-time 15 \
        -o /dev/null -w '%{http_code}' "$AUTO_TEST_URL" 2>/dev/null); then
        YOUTUBE_RESULT="HTTP=${code:-000}"
    else
        curl_status=$?
        YOUTUBE_RESULT="curl=$curl_status HTTP=${code:-000}"
        return 1
    fi
    case "$code" in 2??|3??) return 0;; *) return 1;; esac
}

load_auto_env() {
    [ -n "$SUB_URL" ] && return 0
    if [ -z "$ENV_FILE" ]; then
        if [ -f .env ]; then ENV_FILE=.env; else ENV_FILE=/root/.env; fi
    fi
    [ -f "$ENV_FILE" ] || die "не найден .env: $ENV_FILE"
    SUB_URL=$(sed -n 's/^[[:space:]]*VPN_SUBSCRIPTION_URL[[:space:]]*=[[:space:]]*//p' "$ENV_FILE" | tail -n 1 | tr -d '\r')
    case "$SUB_URL" in
        \"*\") SUB_URL=${SUB_URL#\"}; SUB_URL=${SUB_URL%\"};;
        \'*\') SUB_URL=${SUB_URL#\'}; SUB_URL=${SUB_URL%\'};;
    esac
    [ -n "$SUB_URL" ] || die "VPN_SUBSCRIPTION_URL не задан в $ENV_FILE"
}

usage() {
    cat <<EOF
Использование:
  vpn download --subscription-url URL --output subscription.sub
  vpn nodes --subscription-file subscription.sub
  vpn benchmark --subscription-file subscription.sub [--max N] [--apply-best]
  vpn homeproxy-manual --subscription-file subscription.sub [--node N]
  vpn homeproxy-uci --subscription-file subscription.sub --node N
  vpn homeproxy-apply --subscription-file subscription.sub --node N [--routing-node NAME]
  vpn auto [--max N] [--env-file /root/.env] [--output subscription.sub]

Также поддерживаются старые флаги: --list, --benchmark, --manual, --uci, --apply.
По умолчанию читается /root/subscription.sub, затем /root/connliberty.sub.
Источник можно переопределить через VPN_SUBSCRIPTION_FILE или VPN_SUBSCRIPTION_URL.
Для --apply создаётся backup /etc/config/homeproxy.bak-DATE.
auto проверяет YouTube, затем тестирует все ноды и применяет только рабочие, начиная с самой быстрой.
URL подписки читается из VPN_SUBSCRIPTION_URL в .env или /root/.env.
EOF
}

if [ "$#" -gt 0 ]; then
    case "$1" in
        download) MODE=download; shift;;
        nodes) MODE=list; shift;;
        benchmark) MODE=benchmark; shift;;
        homeproxy-manual) MODE=manual; shift;;
        homeproxy-uci) MODE=uci; shift;;
        homeproxy-apply) MODE=apply; shift;;
        auto) MODE=auto; shift;;
        help) usage; exit 0;;
    esac
fi

while [ "$#" -gt 0 ]; do
    case "$1" in
        -f|--file|--subscription-file) SUB_FILE=$2; shift 2;;
        -u|--url|--subscription-url) SUB_URL=$2; shift 2;;
        -o|--output) SUB_OUTPUT=$2; shift 2;;
        --test-url) TEST_URL=$2; shift 2;;
        --max) MAX_NODES=$2; shift 2;;
        --node) NODE_INDEX=$2; shift 2;;
        --section) SECTION=$2; shift 2;;
        --routing-node) ROUTING_NODE=$2; shift 2;;
        --list) MODE=list; shift;;
        --benchmark) MODE=benchmark; shift;;
        --manual) MODE=manual; shift;;
        --uci) MODE=uci; shift;;
        --apply) MODE=apply; shift;;
        --apply-best) APPLY_BEST=1; shift;;
        --env-file) ENV_FILE=$2; shift 2;;
        -h|--help) usage; exit 0;;
        *) die "неизвестный параметр: $1";;
    esac
done

if [ "$MODE" = auto ]; then
    need curl; need jq
    if youtube_available; then
        log "YouTube доступен ($YOUTUBE_RESULT); ничего не меняем."
        exit 0
    else
        probe_status=$?
        [ "$probe_status" -eq 1 ] || die "не удалось проверить YouTube через HomeProxy: $YOUTUBE_RESULT"
    fi
    log "YouTube недоступен ($YOUTUBE_RESULT); ищем рабочую ноду."
    mkdir "$AUTO_LOCK_DIR" 2>/dev/null || die 'другой запуск vpn auto уже выполняется'
    AUTO_LOCK=1
    [ "$(id -u)" = 0 ] || die 'auto требует root'
    need jq
    [ -z "$NODE_INDEX" ] || die 'auto проверяет все ноды; --node здесь не используется'
    case "$MAX_NODES" in ''|*[!0-9]*) die '--max должен быть неотрицательным числом';; esac
    load_auto_env
    [ -f "$HOMEPROXY_CONFIG" ] || die "не найден $HOMEPROXY_CONFIG"
    auto_backup_candidate="$HOMEPROXY_CONFIG.bak-auto-$(date +%Y%m%d-%H%M%S)-$$"
    cp -p "$HOMEPROXY_CONFIG" "$auto_backup_candidate" || die 'не удалось сохранить исходную конфигурацию HomeProxy'
    AUTO_BACKUP=$auto_backup_candidate
    log "Backup HomeProxy: $AUTO_BACKUP"
    log 'Останавливаем HomeProxy...'
    "$HOMEPROXY_SERVICE" stop || die 'не удалось остановить HomeProxy'
    log 'HomeProxy остановлен.'
fi

need jq
echo "$SECTION" | grep -Eq '^[A-Za-z0-9_]+$' || die 'section допускает только A-Z, a-z, 0-9 и _'
[ -z "$ROUTING_NODE" ] || echo "$ROUTING_NODE" | grep -Eq '^[A-Za-z0-9_]+$' || die 'routing-node допускает только A-Z, a-z, 0-9 и _'

if [ -n "$SUB_URL" ]; then
    need curl
    [ "$MODE" != auto ] || log 'Скачиваем подписку (ожидание до 60 с)...'
    curl -fsSL --max-time 60 -A 'Happ/1.0' "$SUB_URL" -o "$RAW" || die 'не удалось скачать подписку'
elif [ -n "$SUB_FILE" ] && [ -s "$SUB_FILE" ]; then
    cp "$SUB_FILE" "$RAW" || die 'не удалось прочитать подписку'
else
    die 'укажите -f FILE или -u URL'
fi

decode_base64_subscription() {
    if command -v base64 >/dev/null 2>&1; then
        base64 -d "$RAW" > "$TEXT" 2>/dev/null && return 0
        base64 -D "$RAW" > "$TEXT" 2>/dev/null && return 0
    fi
    if command -v busybox >/dev/null 2>&1; then
        busybox base64 -d "$RAW" > "$TEXT" 2>/dev/null && return 0
    fi
    if command -v openssl >/dev/null 2>&1; then
        openssl base64 -d -A -in "$RAW" -out "$TEXT" 2>/dev/null && return 0
    fi
    return 1
}

if grep -q 'vless://' "$RAW" 2>/dev/null || head -c 1 "$RAW" | grep -q '[{[]'; then
    cp "$RAW" "$TEXT"
else
    decode_base64_subscription || die 'подписка похожа на Base64, но декодер недоступен; установите coreutils-base64'
fi

url_decode() { printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')" 2>/dev/null || printf '%s' "$1"; }
query_value() {
    printf '%s' "$1" | sed 's/^[^?]*?//; s/#.*$//' | tr '&' '\n' | awk -F= -v key="$2" '$1==key {print substr($0,length($1)+2); exit}'
}
parse_uri() {
    uri=$1
    body=${uri#vless://}; uuid=${body%@*}; rest=${body#*@}; hostport=${rest%%\?*}
    host=${hostport%:*}; port=${hostport##*:}; [ "$host" = "$port" ] && port=443
    label=$(url_decode "${uri#*#}"); [ "$label" = "$uri" ] && label="$host:$port"
    flow=$(url_decode "$(query_value "$uri" flow)"); [ -n "$flow" ] || flow=xtls-rprx-vision
    sni=$(url_decode "$(query_value "$uri" sni)"); [ -n "$sni" ] || sni=$(url_decode "$(query_value "$uri" serverName)"); [ -n "$sni" ] || sni=$host
    fp=$(url_decode "$(query_value "$uri" fp)"); [ -n "$fp" ] || fp=firefox
    pbk=$(url_decode "$(query_value "$uri" pbk)"); [ -n "$pbk" ] || pbk=$(url_decode "$(query_value "$uri" publicKey)")
    sid=$(url_decode "$(query_value "$uri" sid)"); [ -n "$sid" ] || sid=$(url_decode "$(query_value "$uri" shortId)")
    transport=$(url_decode "$(query_value "$uri" type)"); [ -n "$transport" ] || transport=tcp
    [ -n "$uuid" ] && [ -n "$host" ] && [ -n "$pbk" ] && [ -n "$sid" ] && [ "$transport" = tcp ] || return 1
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$label" "$host" "$port" "$uuid" "$flow" "$sni" "$fp" "$pbk" "$sid"
}

: > "$NODES"
if grep -q 'vless://' "$TEXT" 2>/dev/null; then
    grep -o 'vless://[^[:space:]]*' "$TEXT" | while IFS= read -r uri; do parse_uri "$uri" >> "$NODES" || true; done
else
    jq -r '
      (if type == "array" then .[] else . end) as $cfg
      | ($cfg.outbounds // [])[]?
      | select(.protocol == "vless")
      | . as $ob | ($ob.settings.vnext[0] // {}) as $v | ($v.users[0] // {}) as $u
      | ($ob.streamSettings // {}) as $s | ($s.realitySettings // {}) as $r
      | select(($s.security // "reality") == "reality")
      | [($ob.tag // $cfg.remarks // "node"), ($v.address // ""), (($v.port // 443)|tostring),
         ($u.id // ""), ($u.flow // "xtls-rprx-vision"), ($r.serverName // $v.address // ""),
         ($r.fingerprint // "firefox"), ($r.publicKey // ""), ($r.shortId // "")] | @tsv
    ' "$TEXT" > "$NODES" 2>/dev/null || die 'не удалось разобрать JSON-подписку'
fi

cp "$NODES" "$NODES.raw"
: > "$NODES.ok"
while IFS="$TAB" read -r label host port uuid flow sni fp pbk sid; do
    [ -n "$host" ] && [ -n "$sni" ] || continue
    echo "$port" | grep -Eq '^[0-9]+$' || continue
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || continue
    echo "$uuid" | grep -Eq '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$' || continue
    [ "$flow" = xtls-rprx-vision ] || continue
    echo "$pbk" | grep -Eq '^[A-Za-z0-9_-]{43}=?$' || continue
    echo "$sid" | grep -Eq '^([0-9A-Fa-f]{2}){1,8}$' || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$label" "$host" "$port" "$uuid" "$flow" "$sni" "$fp" "$pbk" "$sid" >> "$NODES.ok"
done < "$NODES.raw"
mv "$NODES.ok" "$NODES"
rm -f "$NODES.raw"
COUNT=$(wc -l < "$NODES" | tr -d ' ')
[ "$COUNT" -gt 0 ] || die 'валидные VLESS Reality-ноды не найдены'

download_subscription() {
    target=$SUB_OUTPUT
    target_dir=${target%/*}
    [ "$target_dir" = "$target" ] && target_dir=.
    [ -d "$target_dir" ] || die "каталог не существует: $target_dir"
    if [ -e "$target" ]; then
        backup="$target.bak-$(date +%Y%m%d-%H%M%S)-$$"
        cp "$target" "$backup" || die 'не удалось создать backup подписки'
        log "Backup: $backup"
    fi
    SUB_TEMP="$target.tmp.$$"
    cp "$RAW" "$SUB_TEMP" || die 'не удалось сохранить подписку'
    chmod 600 "$SUB_TEMP" || die 'не удалось защитить файл подписки'
    mv "$SUB_TEMP" "$target" || die 'не удалось заменить файл подписки'
    SUB_TEMP=''
    log "Сохранено: $target"
    log "Валидных VLESS Reality-нод: $COUNT"
}

show_list() { awk -F '\t' '{printf "%3d %-30s %s:%s sni=%s\n", NR, substr($1,1,30), $2, $3, $6}' "$NODES"; }
get_node() { awk -F '\t' -v n="$1" 'NR==n {print; exit}' "$NODES"; }
require_node() {
    [ -n "$NODE_INDEX" ] || die 'для этого режима требуется --node N'
    NODE_LINE=$(get_node "$NODE_INDEX"); [ -n "$NODE_LINE" ] || die "нода $NODE_INDEX не найдена"
}
read_node() { IFS="$TAB" read -r N_NAME N_HOST N_PORT N_UUID N_FLOW N_SNI N_FP N_PBK N_SID <<EOF
$1
EOF
}

print_manual_line() {
    read_node "$1"
    cat <<EOF
Address: $N_HOST
Port: $N_PORT
UUID: $N_UUID
SNI: $N_SNI
uTLS fingerprint: $N_FP
Reality public key: $N_PBK
Reality short ID: $N_SID
EOF
}
manual() {
    cat <<EOF
ОБЩИЕ ПОЛЯ HOMEPROXY
Type: VLESS
TLS: включён
Reality: включён
Network/Transport: TCP
Flow: xtls-rprx-vision
Packet encoding: xudp
Allow insecure: выключено
EOF
    if [ -n "$NODE_INDEX" ]; then require_node; print_manual_line "$NODE_LINE"; else
        index=0
        while IFS= read -r line; do index=$((index + 1)); log ''; log "НОДА $index"; print_manual_line "$line"; done < "$NODES"
    fi
    log ''; log 'Не переносить: burstObservatory, SOCKS/HTTP-порты, пути логов, level, mux, DNS Happ, leastLoad.'
}

print_uci() {
    need uci
    read_node "$1"
    resolve_homeproxy_routing
    print_set() { escaped=$(printf '%s' "$2" | sed "s/'/'\\\\''/g"); printf "uci set %s='%s'\n" "$1" "$escaped"; }
    print_set "homeproxy.$SECTION" node
    print_set "homeproxy.$SECTION.label" "$N_NAME"
    print_set "homeproxy.$SECTION.type" vless
    print_set "homeproxy.$SECTION.address" "$N_HOST"
    print_set "homeproxy.$SECTION.port" "$N_PORT"
    print_set "homeproxy.$SECTION.uuid" "$N_UUID"
    print_set "homeproxy.$SECTION.tls" 1
    print_set "homeproxy.$SECTION.tls_sni" "$N_SNI"
    print_set "homeproxy.$SECTION.tls_reality" 1
    print_set "homeproxy.$SECTION.tls_reality_public_key" "$N_PBK"
    print_set "homeproxy.$SECTION.tls_reality_short_id" "$N_SID"
    print_set "homeproxy.$SECTION.tls_utls" "$N_FP"
    print_set "homeproxy.$SECTION.vless_flow" "$N_FLOW"
    print_set "homeproxy.$SECTION.packet_encoding" xudp
    if [ "$ROUTING_MODE" = custom ]; then
        print_set "homeproxy.$ROUTING_NODE.node" "$SECTION"
    else
        print_set homeproxy.config.main_node "$SECTION"
        print_set homeproxy.config.main_udp_node same
    fi
    printf '%s\n' 'uci commit homeproxy' '/etc/init.d/homeproxy restart'
}

resolve_homeproxy_routing() {
    ROUTING_MODE=$(uci -q get homeproxy.config.routing_mode 2>/dev/null || true)
    [ -n "$ROUTING_MODE" ] || ROUTING_MODE=bypass_mainland_china
    [ "$ROUTING_MODE" = custom ] || return 0
    if [ -n "$ROUTING_NODE" ]; then
        [ "$(uci -q get "homeproxy.$ROUTING_NODE" 2>/dev/null || true)" = routing_node ] || die "routing node не найден: $ROUTING_NODE"
        return 0
    fi
    candidates=$(uci -q show homeproxy 2>/dev/null | sed -n 's/^homeproxy\.\([^=]*\)=routing_node$/\1/p')
    enabled=''
    for candidate in $candidates; do
        [ "$(uci -q get "homeproxy.$candidate.enabled" 2>/dev/null || true)" = 1 ] && enabled="$enabled $candidate"
    done
    set -- $enabled
    if [ "$#" = 1 ]; then
        ROUTING_NODE=$1
        return 0
    fi
    set -- $candidates
    if [ "$#" = 1 ]; then
        ROUTING_NODE=$1
        return 0
    fi
    err "HomeProxy использует custom routing; найдено routing nodes: ${candidates:-нет}"
    die 'укажите нужный через --routing-node NAME'
}

apply_node() {
    [ "$(id -u)" = 0 ] || die '--apply требует root'
    need uci
    read_node "$1"
    resolve_homeproxy_routing
    log "Применяется нода $NODE_INDEX: $N_HOST:$N_PORT, short ID=$N_SID"
    log "Режим HomeProxy: $ROUTING_MODE${ROUTING_NODE:+, routing node=$ROUTING_NODE}"
    backup=${AUTO_BACKUP:-/etc/config/homeproxy.bak-$(date +%Y%m%d-%H%M%S)}
    restart_log="$WORK_DIR.restart.log"
    if [ -z "$AUTO_BACKUP" ]; then
        cp "$HOMEPROXY_CONFIG" "$backup" || die 'не удалось создать backup HomeProxy'
    fi
    uci set "homeproxy.$SECTION=node"
    uci set "homeproxy.$SECTION.label=$N_NAME"
    uci set "homeproxy.$SECTION.type=vless"
    uci set "homeproxy.$SECTION.address=$N_HOST"
    uci set "homeproxy.$SECTION.port=$N_PORT"
    uci set "homeproxy.$SECTION.uuid=$N_UUID"
    uci set "homeproxy.$SECTION.tls=1"
    uci set "homeproxy.$SECTION.tls_sni=$N_SNI"
    uci set "homeproxy.$SECTION.tls_reality=1"
    uci set "homeproxy.$SECTION.tls_reality_public_key=$N_PBK"
    uci set "homeproxy.$SECTION.tls_reality_short_id=$N_SID"
    uci set "homeproxy.$SECTION.tls_utls=$N_FP"
    uci set "homeproxy.$SECTION.vless_flow=$N_FLOW"
    uci set "homeproxy.$SECTION.packet_encoding=xudp"
    if [ "$ROUTING_MODE" = custom ]; then
        uci set "homeproxy.$ROUTING_NODE.node=$SECTION"
    else
        uci set "homeproxy.config.main_node=$SECTION"
        uci set 'homeproxy.config.main_udp_node=same'
    fi
    uci commit homeproxy

    verify_uci() {
        verify_option "homeproxy.$SECTION.address" "$N_HOST" || return 1
        verify_option "homeproxy.$SECTION.port" "$N_PORT" || return 1
        verify_option "homeproxy.$SECTION.uuid" "$N_UUID" || return 1
        verify_option "homeproxy.$SECTION.tls_sni" "$N_SNI" || return 1
        verify_option "homeproxy.$SECTION.tls_reality_public_key" "$N_PBK" || return 1
        verify_option "homeproxy.$SECTION.tls_reality_short_id" "$N_SID" || return 1
        if [ "$ROUTING_MODE" = custom ]; then
            verify_option "homeproxy.$ROUTING_NODE.node" "$SECTION" || return 1
        else
            verify_option "homeproxy.config.main_node" "$SECTION" || return 1
        fi
    }
    verify_option() {
        option=$1 expected=$2
        actual=$(uci -q get "$option" 2>/dev/null || true)
        if [ "$actual" != "$expected" ]; then
            err "$option: ожидалось '$expected', записано '$actual'"
            return 1
        fi
    }
    rollback_homeproxy() {
        cp "$backup" "$HOMEPROXY_CONFIG"
        "$HOMEPROXY_SERVICE" restart >/dev/null 2>&1 || true
        die "$1; предыдущая конфигурация восстановлена из $backup"
    }

    verify_uci || rollback_homeproxy 'UCI-параметры изменились сразу после commit'
    if ! "$HOMEPROXY_SERVICE" restart >"$restart_log" 2>&1; then
        sed -n '1,20p' "$restart_log" >&2
        rollback_homeproxy 'HomeProxy restart завершился ошибкой'
    fi
    sleep 3
    verify_uci || rollback_homeproxy 'UCI-параметры изменились после restart'
    if ! "$HOMEPROXY_SERVICE" status >/dev/null 2>&1; then
        rollback_homeproxy 'HomeProxy не перешёл в состояние running'
    fi
    runtime_config=$HOMEPROXY_RUNTIME_CONFIG
    if [ ! -s "$runtime_config" ]; then
        rollback_homeproxy 'HomeProxy не создал runtime-конфигурацию sing-box'
    fi
    if [ "$ROUTING_MODE" = custom ]; then runtime_tag="cfg-$SECTION-out"; else runtime_tag=main-out; fi
    if ! jq -e --arg tag "$runtime_tag" --arg host "$N_HOST" --argjson port "$N_PORT" --arg uuid "$N_UUID" --arg pbk "$N_PBK" --arg sid "$N_SID" '
        any(.outbounds[]?;
            .tag == $tag and .type == "vless" and .server == $host and .server_port == $port
            and .uuid == $uuid and .tls.reality.public_key == $pbk and .tls.reality.short_id == $sid)
    ' "$runtime_config" >/dev/null 2>&1; then
        rollback_homeproxy 'runtime-конфигурация sing-box не содержит выбранную ноду или short ID'
    fi
    if [ -s "$restart_log" ]; then
        log 'Вывод HomeProxy restart:'
        sed -n '1,10p' "$restart_log"
    fi
    log "HomeProxy обновлён и проверен. Backup: $backup"
}

make_config() {
    read_node "$2"
    jq -n --arg host "$N_HOST" --argjson port "$N_PORT" --arg uuid "$N_UUID" --arg flow "$N_FLOW" --arg sni "$N_SNI" --arg fp "$N_FP" --arg pbk "$N_PBK" --arg sid "$N_SID" --argjson local_port "$3" '
      {log:{level:"error"},inbounds:[{type:"socks",tag:"socks-in",listen:"127.0.0.1",listen_port:$local_port}],
       outbounds:[{type:"vless",tag:"proxy",server:$host,server_port:$port,uuid:$uuid,flow:$flow,network:"tcp",packet_encoding:"xudp",
       tls:{enabled:true,insecure:false,server_name:$sni,utls:{enabled:true,fingerprint:$fp},reality:{enabled:true,public_key:$pbk,short_id:$sid}}},{type:"direct",tag:"direct"}],route:{final:"proxy"}}' > "$1"
}

benchmark() {
    need sing-box; need curl
    : > "$RESULTS"
    index=0
    while IFS= read -r line; do
        index=$((index + 1)); [ "$MAX_NODES" -gt 0 ] && [ "$index" -gt "$MAX_NODES" ] && break
        read_node "$line"; local_port=$((BASE_PORT + index)); cfg="$WORK_DIR.$index.json"; logfile="$WORK_DIR.$index.log"
        log "[$index/$COUNT] $N_NAME $N_HOST:$N_PORT"
        make_config "$cfg" "$line" "$local_port"
        if ! sing-box check -c "$cfg" >"$logfile" 2>&1; then log '  CONFIG FAIL'; continue; fi
        sing-box run -c "$cfg" >>"$logfile" 2>&1 & SB_PID=$!; sleep 1
        output=$(curl --socks5-hostname "127.0.0.1:$local_port" -4 -LsS --connect-timeout 7 --max-time 25 -o /dev/null -w '%{http_code}\t%{time_total}\t%{speed_download}' "$TEST_URL" 2>/dev/null || true)
        kill "$SB_PID" >/dev/null 2>&1 || true; wait "$SB_PID" 2>/dev/null || true; SB_PID=''
        code=$(printf '%s' "$output" | awk -F '\t' '{print $1}'); total=$(printf '%s' "$output" | awk -F '\t' '{print $2}'); speed=$(printf '%s' "$output" | awk -F '\t' '{print $3}')
        case "$code" in 200|204|301|302) log "  OK HTTP=$code total=${total}s speed=${speed}B/s"; printf '%s\t%s\t%s\n' "$total" "$index" "$line" >> "$RESULTS";; *) log "  FAIL HTTP=${code:-000}";; esac
    done < "$NODES"
    [ -s "$RESULTS" ] || die 'рабочие ноды не найдены'
    [ "$MODE" = auto ] && return 0
    log ''; log 'TOP:'; sort -n -k1,1 "$RESULTS" | head -15 | awk -F '\t' '{printf "%7sms node=%s %s %s:%s\n", $1*1000,$2,$3,$4,$5}'
    BEST=$(sort -n -k1,1 "$RESULTS" | head -1 | cut -f2)
    log ''; log "Лучшая нода: $BEST"
    NODE_INDEX=$BEST; require_node; log ''; log 'Инструкция HomeProxy:'; print_manual_line "$NODE_LINE"
    if [ "$APPLY_BEST" = 1 ]; then
        log ''; apply_node "$NODE_LINE"
    fi
}

auto() {
    download_subscription
    attempt_limit=$MAX_NODES
    MAX_NODES=0
    log "Проверяем все $COUNT нод через sing-box."
    benchmark
    sort -n -k1,1 "$RESULTS" | cut -f2 > "$CANDIDATES"
    working_count=$(wc -l < "$CANDIDATES" | tr -d ' ')
    log "Рабочих нод: $working_count. Пробуем их по скорости."
    attempted=0
    while IFS= read -r index; do
        [ "$attempt_limit" -gt 0 ] && [ "$attempted" -ge "$attempt_limit" ] && break
        NODE_INDEX=$index
        NODE_LINE=$(get_node "$index")
        log "Пробуем ноду $index/$COUNT"
        apply_node "$NODE_LINE"
        attempted=$((attempted + 1))
        if youtube_available; then
            AUTO_SUCCESS=1
            log "YouTube доступен ($YOUTUBE_RESULT); оставлена нода $index."
            return 0
        else
            probe_status=$?
            [ "$probe_status" -eq 1 ] || die "не удалось проверить YouTube через HomeProxy: $YOUTUBE_RESULT"
        fi
        log "YouTube недоступен через ноду $index ($YOUTUBE_RESULT)."
    done < "$CANDIDATES"
    die "проверены $attempted нод, YouTube недоступен"
}

case "$MODE" in
    download) download_subscription;;
    list) show_list;;
    manual) manual;;
    uci) require_node; print_uci "$NODE_LINE";;
    apply) require_node; apply_node "$NODE_LINE";;
    benchmark) benchmark;;
    auto) auto;;
esac
